            }
          }
        }
      }
    },
    "/api/v2/public/quotes": {
      "post": {
        "tags": [
          "Checkout"
        ],
        "summary": "Checkout delivery quote",
        "description": "Called by the checkout widget from the buyer's browser. The publishable key must list the request's Origin. Vehicle comes from cart weight (up to 120 kg by motorbike, up to 1,000 kg by van).",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "key",
                  "lat",
                  "lng"
                ],
                "properties": {
                  "key": {
                    "type": "string",
                    "description": "Publishable key, dpk_"
                  },
                  "lat": {
                    "type": "number"
                  },
                  "lng": {
                    "type": "number"
                  },
                  "weight_kg": {
                    "type": "number",
                    "minimum": 0
                  },
                  "address": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "key": "dpk_test_...",
                "lat": -1.2905,
                "lng": 36.786,
                "weight_kg": 2.5,
                "address": "Kilimani, Nairobi"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A price, or why there isn't one",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "covered": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string",
                      "description": "When not covered"
                    },
                    "quote_id": {
                      "type": "string"
                    },
                    "fee_kes": {
                      "type": "integer"
                    },
                    "vehicle_class": {
                      "type": "string"
                    },
                    "distance_km": {
                      "type": "number"
                    },
                    "expires_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "test": {
                      "type": "boolean"
                    },
                    "delivery_promise": {
                      "type": "string"
                    },
                    "notices": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Not valid JSON, or an unknown field",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Key not allowed from this website",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Refused by a business rule; the message is safe to show",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/public/stores": {
      "get": {
        "tags": [
          "Public"
        ],
        "summary": "List outlets",
        "security": [],
        "responses": {
          "200": {
            "description": "Active UrbnBox outlets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Store"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/public/stores/nearby": {
      "get": {
        "tags": [
          "Public"
        ],
        "summary": "Outlets near a point",
        "security": [],
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "lng",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "radius",
            "in": "query",
            "schema": {
              "type": "number",
              "default": 5000
            },
            "description": "Metres"
          }
        ],
        "responses": {
          "200": {
            "description": "Outlets within the radius",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Store"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/integrations/shopify/carrier-rates": {
      "post": {
        "tags": [
          "Shopify callbacks"
        ],
        "summary": "Shopify carrier rates",
        "description": "Called by Shopify at checkout through the signed callback URL UrbnBox registers. Returns UrbnBox door delivery when the address is in the Nairobi metro area, or no rates.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Rates in Shopify's format",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "rates": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/integrations/shopify/orders-paid": {
      "post": {
        "tags": [
          "Shopify callbacks"
        ],
        "summary": "Shopify paid order",
        "description": "Shopify's orders/paid webhook, verified with X-Shopify-Hmac-Sha256. Books the order once; retries are ignored.",
        "security": [],
        "parameters": [
          {
            "name": "X-Shopify-Hmac-Sha256",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Received"
          },
          "401": {
            "description": "Bad signature"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "SecretKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Secret key, dk_test_ or dk_live_"
      },
      "BearerKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "The same secret key as a bearer token"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "bad_request",
                  "unauthorized",
                  "forbidden",
                  "not_found",
                  "rejected",
                  "rate_limited",
                  "unavailable",
                  "internal"
                ]
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        }
      },
      "QuoteRequest": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "delivery",
              "lane",
              "hire"
            ]
          },
          "vehicle_class": {
            "type": "string",
            "description": "From the rate card",
            "enum": [
              "rider",
              "van",
              "truck_10t_dry",
              "reefer_3t",
              "reefer_5t"
            ]
          },
          "temperature": {
            "type": "string",
            "enum": [
              "dry",
              "chilled",
              "frozen"
            ],
            "default": "dry"
          },
          "city": {
            "type": "string",
            "default": "Nairobi",
            "description": "Delivery"
          },
          "distance_km": {
            "type": "number",
            "description": "Delivery: road distance"
          },
          "drops": {
            "type": "integer",
            "minimum": 1,
            "default": 1,
            "description": "Delivery: number of drops"
          },
          "origin_town": {
            "type": "string",
            "description": "Lane"
          },
          "destination_town": {
            "type": "string",
            "description": "Lane"
          },
          "hire_period": {
            "type": "string",
            "enum": [
              "half_day",
              "day"
            ],
            "description": "Hire"
          },
          "hire_periods": {
            "type": "integer",
            "minimum": 1,
            "description": "Hire: how many periods"
          },
          "outside_hours": {
            "type": "boolean",
            "description": "Adds the out-of-hours surcharge when your card has one"
          }
        }
      },
      "QuoteLine": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "amount_kes": {
            "type": "integer"
          },
          "rule_type": {
            "type": "string"
          },
          "rule_id": {
            "type": "string"
          },
          "customer_rate": {
            "type": "boolean",
            "description": "True when the line comes from your own rate card"
          }
        }
      },
      "Quote": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "vehicle_class": {
            "type": "string"
          },
          "temperature": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuoteLine"
            },
            "description": "What makes up the total"
          },
          "total_kes": {
            "type": "integer"
          },
          "test": {
            "type": "boolean"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Recipient": {
        "type": "object",
        "required": [
          "name",
          "phone"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string",
            "description": "Kenyan mobile number"
          },
          "address": {
            "type": "string",
            "description": "Optional when the quote came from the checkout widget"
          },
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          }
        }
      },
      "StopInput": {
        "type": "object",
        "required": [
          "kind",
          "name"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "pickup",
              "drop"
            ]
          },
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          },
          "notes": {
            "type": "string"
          },
          "requires_handover_code": {
            "type": "boolean",
            "description": "The recipient gets a 4-digit code on WhatsApp"
          },
          "collect_goods_kes": {
            "type": "integer",
            "minimum": 0,
            "description": "Cash for the goods, collected here"
          }
        }
      },
      "OrderRequest": {
        "type": "object",
        "required": [
          "quote_id",
          "reference"
        ],
        "description": "Send either recipient (short form) or stops, not both.",
        "properties": {
          "quote_id": {
            "type": "string"
          },
          "reference": {
            "type": "string",
            "description": "Your order number; unique per account, makes booking idempotent"
          },
          "fee_payer": {
            "type": "string",
            "enum": [
              "buyer_on_delivery",
              "buyer_paid",
              "merchant_wallet",
              "merchant_cod"
            ],
            "default": "buyer_on_delivery"
          },
          "recipient": {
            "$ref": "#/components/schemas/Recipient"
          },
          "description": {
            "type": "string",
            "description": "Short form: what is being delivered"
          },
          "collect_kes": {
            "type": "integer",
            "minimum": 0,
            "description": "Short form: cash for the goods"
          },
          "stops": {
            "type": "array",
            "minItems": 2,
            "items": {
              "$ref": "#/components/schemas/StopInput"
            }
          },
          "notes": {
            "type": "string"
          },
          "hire_starts_at": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "type": "string",
            "enum": [
              "api",
              "shopify",
              "woocommerce",
              "widget"
            ]
          }
        }
      },
      "Stop": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "sequence": {
            "type": "integer"
          },
          "kind": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "arrived",
              "done",
              "failed"
            ]
          },
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "collect_kes": {
            "type": "integer"
          }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "booked",
              "scheduled",
              "in_progress",
              "completed",
              "failed",
              "cancelled"
            ]
          },
          "kind": {
            "type": "string"
          },
          "vehicle_class": {
            "type": "string"
          },
          "temperature": {
            "type": "string"
          },
          "quote_id": {
            "type": "string"
          },
          "fee_kes": {
            "type": "integer"
          },
          "fee_payer": {
            "type": "string"
          },
          "fee_paid": {
            "type": "boolean"
          },
          "source": {
            "type": "string"
          },
          "test": {
            "type": "boolean"
          },
          "on_hold_reason": {
            "type": "string",
            "description": "Set when the order waits, for example on an empty wallet"
          },
          "return_of_order_id": {
            "type": "string"
          },
          "tracking_url": {
            "type": "string",
            "format": "uri"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "stops": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Stop"
            }
          }
        }
      },
      "Webhook": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "active": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Store": {
        "type": "object",
        "description": "An UrbnBox outlet",
        "additionalProperties": true
      }
    }
  }
}
