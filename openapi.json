{
  "openapi": "3.0.3",
  "info": {
    "title": "UrbnBox API",
    "version": "2.0.0",
    "description": "Price and book UrbnBox deliveries. Every endpoint is under /api/v2; the v1 APIs were switched off on 5 November 2026."
  },
  "servers": [
    {
      "url": "https://portal.urbnbox.io"
    }
  ],
  "tags": [
    {
      "name": "Quotes"
    },
    {
      "name": "Orders"
    },
    {
      "name": "Stock and invoices"
    },
    {
      "name": "Webhooks"
    },
    {
      "name": "Checkout"
    },
    {
      "name": "Public"
    },
    {
      "name": "Shopify callbacks"
    }
  ],
  "paths": {
    "/api/v2/quotes": {
      "post": {
        "tags": [
          "Quotes"
        ],
        "summary": "Create a quote",
        "description": "Prices an order from your rate card and stores the quote. Valid for 24 hours.",
        "security": [
          {
            "SecretKey": []
          },
          {
            "BearerKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuoteRequest"
              },
              "example": {
                "kind": "delivery",
                "vehicle_class": "rider",
                "distance_km": 7.5
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The quote",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Quote"
                }
              }
            }
          },
          "400": {
            "description": "Not valid JSON, or an unknown field",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, unknown or switched-off key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Refused by a business rule; the message is safe to show",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/quotes/{id}": {
      "get": {
        "tags": [
          "Quotes"
        ],
        "summary": "Get a quote",
        "security": [
          {
            "SecretKey": []
          },
          {
            "BearerKey": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The quote",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Quote"
                }
              }
            }
          },
          "401": {
            "description": "Missing, unknown or switched-off key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found on your account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/orders": {
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "Book an order",
        "description": "Books one order against a quote. Repeating a reference returns the order already booked.",
        "security": [
          {
            "SecretKey": []
          },
          {
            "BearerKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderRequest"
              },
              "example": {
                "quote_id": "4f1c2b0e-...",
                "reference": "ORDER-1001",
                "recipient": {
                  "name": "Jane Mwangi",
                  "phone": "+254712345678",
                  "address": "Kilimani, Nairobi"
                },
                "description": "2 cartons",
                "collect_kes": 2400
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "400": {
            "description": "Not valid JSON, or an unknown field",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, unknown or switched-off key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Refused by a business rule; the message is safe to show",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Orders"
        ],
        "summary": "List orders",
        "description": "Newest first.",
        "security": [
          {
            "SecretKey": []
          },
          {
            "BearerKey": []
          }
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "booked",
                "scheduled",
                "in_progress",
                "completed",
                "failed",
                "cancelled"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Orders",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "orders": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Order"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, unknown or switched-off key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/orders/batch": {
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "Book a batch",
        "description": "Up to 500 orders. Each is booked or refused on its own.",
        "security": [
          {
            "SecretKey": []
          },
          {
            "BearerKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "orders"
                ],
                "properties": {
                  "orders": {
                    "type": "array",
                    "maxItems": 500,
                    "items": {
                      "$ref": "#/components/schemas/OrderRequest"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "One result per order",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "reference": {
                            "type": "string"
                          },
                          "order": {
                            "$ref": "#/components/schemas/Order"
                          },
                          "error": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Not valid JSON, or an unknown field",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, unknown or switched-off key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Refused by a business rule; the message is safe to show",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/orders/validate": {
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "Check a CSV",
        "description": "Checks an orders CSV and books nothing. Columns: reference, drop_name, drop_phone, drop_address, collect_goods_kes (optional).",
        "security": [
          {
            "SecretKey": []
          },
          {
            "BearerKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "text/csv": {
              "schema": {
                "type": "string"
              },
              "example": "reference,drop_name,drop_phone,drop_address,collect_goods_kes\nORDER-2001,Jane Mwangi,0712345678,Kilimani,2400\n"
            }
          }
        },
        "responses": {
          "200": {
            "description": "The result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "rows": {
                      "type": "integer"
                    },
                    "valid": {
                      "type": "boolean"
                    },
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "row": {
                            "type": "integer"
                          },
                          "message": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Not valid JSON, or an unknown field",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, unknown or switched-off key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Refused by a business rule; the message is safe to show",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
