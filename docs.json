{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "UrbnBox",
  "colors": {
    "primary": "#111827",
    "light": "#16A34A",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart",
              "guides/integration-options"
            ]
          },
          {
            "group": "Checkout and stores",
            "pages": [
              "guides/checkout-widget",
              "guides/shopify",
              "guides/woocommerce"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/orders-and-quotes",
              "concepts/authentication"
            ]
          },
          {
            "group": "Upgrading",
            "pages": [
              "guides/migrating-from-v1"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "icon": "brackets-curly",
        "openapi": "openapi.json",
        "pages": [
          "reference-overview",
          {
            "group": "Quotes",
            "pages": [
              "POST /api/v2/quotes",
              "GET /api/v2/quotes/{id}"
            ]
          },
          {
            "group": "Orders",
            "pages": [
              "api-reference/orders",
              "POST /api/v2/orders",
              "GET /api/v2/orders",
              "GET /api/v2/orders/{id}",
              "POST /api/v2/orders/batch",
              "POST /api/v2/orders/validate",
              "POST /api/v2/orders/{id}/cancel",
              "POST /api/v2/orders/{id}/return"
            ]
          },
          {
            "group": "Stock and invoices",
            "pages": [
              "GET /api/v2/stock",
              "GET /api/v2/invoices"
            ]
          },
          {
            "group": "Webhooks",
            "pages": [
              "api-reference/webhooks",
              "POST /api/v2/webhooks",
              "GET /api/v2/webhooks",
              "DELETE /api/v2/webhooks/{id}"
            ]
          },
          {
            "group": "Checkout",
            "pages": [
              "POST /api/v2/public/quotes"
            ]
          },
          {
            "group": "Public",
            "pages": [
              "GET /api/v2/public/stores",
              "GET /api/v2/public/stores/nearby"
            ]
          },
          {
            "group": "Shopify callbacks",
            "pages": [
              "POST /integrations/shopify/carrier-rates",
              "POST /integrations/shopify/orders-paid"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "UrbnBox",
          "href": "https://portal.urbnbox.io",
          "icon": "globe"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/icon.png",
    "dark": "/logo/icon.png"
  },
  "navbar": {
    "links": [
      {
        "label": "API quickstart",
        "href": "/quickstart"
      }
    ],
    "primary": {
      "type": "button",
      "label": "UrbnBox app",
      "href": "https://portal.urbnbox.io"
    }
  },
  "api": {
    "openapi": "openapi.json",
    "playground": {
      "display": "interactive",
      "proxy": false
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "redirects": [
    {
      "source": "/api-reference/vendor/orders",
      "destination": "/api-reference/orders"
    },
    {
      "source": "/api-reference/vendor/webhooks",
      "destination": "/api-reference/webhooks"
    },
    {
      "source": "/api-reference/vendor/shipments",
      "destination": "/guides/migrating-from-v1"
    },
    {
      "source": "/guides/pickup-point-shipments",
      "destination": "/guides/migrating-from-v1"
    },
    {
      "source": "/concepts/partners-and-vendors",
      "destination": "/concepts/authentication"
    }
  ]
}
